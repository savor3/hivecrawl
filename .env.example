# Name shown to peers and in the UI. Must be unique in the mesh.
HC_NODE_NAME=my-node

# Which network to join. Leave both empty to join the public community
# network automatically: no keys to share, no peers to configure.
#   HC_NETWORK=off          run alone, never talk to other nodes
#   HC_NETWORK_KEY=...      your own private network instead (>= 16 chars,
#                           e.g. openssl rand -hex 24); every node in it uses
#                           the same key, and HC_PEERS lists its public nodes
HC_NETWORK=
HC_NETWORK_KEY=

# Public node: the HTTPS URL others reach this node at (behind Caddy/nginx).
# Home node behind a router: leave empty, it tunnels out to public nodes.
HC_PUBLIC_URL=

# Extra public nodes to contact first, comma separated (the community network
# has built-in ones). Gossip discovers the rest, and each node remembers the
# public nodes it has met, so it can rejoin even if these are down.
HC_PEERS=

# Keys for the API, MCP and web UI, comma separated. Leave empty and the node
# makes one on first start; print it with: docker compose exec hivecrawl /hivecrawl login
HC_API_KEYS=

# SearXNG's own secret. Leave empty and a random one is made on each start
# (SearXNG is only reachable inside the compose network). Or: openssl rand -hex 32
SEARXNG_SECRET=

# Optional tuning
# HC_WARP=true          # retry blocked engines through Cloudflare WARP before asking peers
# HC_ENGINES=google cse,brave,duckduckgo,startpage,mojeek   # must match deploy/searxng/settings.yml
# HC_PORT=3002
# HC_MIN_RESULTS=8      # fewer local results than this -> ask peers
# HC_CACHE_TTL=1h
# HC_PEER_RATE=30       # base searches/minute one peer may ask; contributors earn up to 3x
# HC_MAX_CONCURRENT=4   # peer searches served at once; when full, contributors go first
# HC_DNS=1.1.1.1:53,8.8.8.8:53
# HC_UI_URL=https://hc.example.com  # sign-in link address; default HC_PUBLIC_URL, else localhost:HC_PORT

# AI model for extract / agent / json / summary. Easiest: set it in the web UI
# (Settings -> AI model). Or here; UI settings win. Provider "anthropic" uses
# Claude's API, anything else is OpenAI-compatible.
# HC_LLM_PROVIDER=anthropic
# HC_LLM_BASE_URL=https://api.anthropic.com/v1
# HC_LLM_MODEL=claude-haiku-5-5
# HC_LLM_API_KEY=

# Browser and crawling
# HC_BROWSER_TABS=4
# HC_TIMEZONE=Asia/Kolkata          # default: detected from the public IP
# HC_CRAWL_MAX_PAGES=5000
# HC_CRAWL_CONCURRENCY=10
# HC_WEBHOOK_SECRET=                 # signs webhooks (X-Firecrawl-Signature)

# Page fetches through the mesh
# HC_SERVE_SCRAPES=false   # true: verified peers may fetch pages through this node's IP
# HC_PEER_SCRAPES=true     # ask opted-in peers when every local tier is blocked
